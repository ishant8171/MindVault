# Copy this file to .env and fill in real values. .env is never committed.

ENV=development

# SQLite for now; swap for a Postgres URL later without code changes.
DATABASE_URL=sqlite:///./mindvault.db

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

FRONTEND_ORIGIN=http://localhost:5173
